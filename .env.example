# Telegram
BOT_TOKEN=

# Yandex Dictionary API — https://yandex.com/dev/dictionary
YANDEX_DICT_KEY=

# LLM-провайдер (генерация примера + фоллбэк), переключаемо через env: groq | …
LLM_PROVIDER=groq
# (опц.) конкретная модель; по умолчанию для groq — openai/gpt-oss-120b
LLM_MODEL=
# Groq API key — бесплатно, без карты: https://console.groq.com/keys
GROQ_API_KEY=

# PostgreSQL
DATABASE_URL=postgres://user:password@localhost:5432/english_bot

# Single-user whitelist: только этот Telegram chat id может пользоваться ботом
OWNER_CHAT_ID=

# Таймзона владельца (IANA, напр. Europe/Moscow); по умолчанию UTC.
# Временное single-user решение; в будущем — выбор в меню настроек (known_issues №6).
OWNER_TZ=
